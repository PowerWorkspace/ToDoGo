checkbox11={cls="checkbox";text="重复";left=182;top=146;right=238;bottom=162;z=22};
checkbox2={cls="checkbox";text="周二";left=124;top=105;right=174;bottom=121;z=6};
checkbox3={cls="checkbox";text="周三";left=182;top=105;right=232;bottom=121;z=7};
